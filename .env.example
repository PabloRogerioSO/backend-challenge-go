# HTTP
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432
POSTGRES_MAX_CONNS=10
# Usada pelo app rodando no host (go run). No compose o host é "postgres".
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=backend
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/backend
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/backend/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=provider-service

# LocalStack / SQS
LOCALSTACK_PORT=4566
LOCALSTACK_ENDPOINT=http://localhost:4566
# Necessário apenas se a imagem do LocalStack exigir autenticação.
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_RECEIVE_COUNT=5

# SQS Configuration (LocalStack)
SQS_ENDPOINT=http://localhost:4566
SQS_INBOUND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_OUTBOUND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions-out.fifo